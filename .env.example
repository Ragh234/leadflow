# Copy to .env and adjust if needed. Every value below is also the default, so
# LeadFlow runs locally without any .env file.

# --- Backend (FastAPI) -------------------------------------------------------
# SQLite file by default. Docker Compose ignores this and points the API at its Postgres.
# Postgres example: postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow
DATABASE_URL=sqlite:///./leadflow.db

# Origin(s) the API accepts browser requests from (CORS), comma-separated.
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ------------------------------------------------------
# The URL the *browser* uses to reach the API. Inlined at build time, so rebuild after changing it.
# For local `npm run dev`, put it in frontend/.env.local instead.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Docker Compose only -----------------------------------------------------
POSTGRES_PASSWORD=leadflow
